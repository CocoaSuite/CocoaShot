{
  "name": "cocoashot",
  "version": "1.5.1",
  "description": "Image editing without the complexity.",
  "main": "electron/main.cjs",
  "author": "CocoaSuite",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "productName": "CocoaShot",
  "homepage": "https://github.com/CocoaSuite/CocoaShot",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/shell-id.mjs && vite build",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.0"
  },
  "devDependencies": {
    "@jsquash/avif": "^2.1.1",
    "ag-psd": "^34.2.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "fflate": "^0.8.2",
    "libheif-js": "^1.23.5",
    "typescript": "^5.9.0",
    "utif": "^3.1.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.cocoasuite.cocoashot",
    "productName": "CocoaShot",
    "copyright": "Copyright © CocoaSuite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/transformers/src/**",
      "!node_modules/@huggingface/transformers/types/**",
      "!node_modules/@huggingface/transformers/dist/*.map",
      "!node_modules/@huggingface/transformers/dist/transformers.{js,min.js,web.js,web.min.js}",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/x64/libonnxruntime_providers_{cuda,tensorrt}.so"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "fileAssociations": [
      {
        "ext": "cocoashot",
        "name": "CocoaShot Project",
        "description": "CocoaShot project",
        "mimeType": "application/x-cocoashot",
        "role": "Editor",
        "icon": "fileicons/cocoashot"
      },
      {
        "ext": "png",
        "name": "CocoaShot.png",
        "description": "PNG image",
        "icon": "fileicons/png",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "jpg",
        "name": "CocoaShot.jpg",
        "description": "JPEG image",
        "icon": "fileicons/jpg",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "jpeg",
        "name": "CocoaShot.jpeg",
        "description": "JPEG image",
        "icon": "fileicons/jpeg",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "webp",
        "name": "CocoaShot.webp",
        "description": "WebP image",
        "icon": "fileicons/webp",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "bmp",
        "name": "CocoaShot.bmp",
        "description": "Bitmap image",
        "icon": "fileicons/bmp",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "tif",
        "name": "CocoaShot.tif",
        "description": "TIFF image",
        "icon": "fileicons/tif",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "tiff",
        "name": "CocoaShot.tiff",
        "description": "TIFF image",
        "icon": "fileicons/tiff",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "gif",
        "name": "CocoaShot.gif",
        "description": "GIF image",
        "icon": "fileicons/gif",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "psd",
        "name": "CocoaShot.psd",
        "description": "Photoshop document",
        "icon": "fileicons/psd",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "avif",
        "name": "CocoaShot.avif",
        "description": "AVIF image",
        "icon": "fileicons/avif",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "heic",
        "name": "CocoaShot.heic",
        "description": "HEIC image",
        "icon": "fileicons/heic",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "heif",
        "name": "CocoaShot.heif",
        "description": "HEIF image",
        "icon": "fileicons/heif",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "svg",
        "name": "CocoaShot.svg",
        "description": "SVG image",
        "icon": "fileicons/svg",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "ico",
        "name": "CocoaShot.ico",
        "description": "Icon",
        "icon": "fileicons/ico",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "tga",
        "name": "CocoaShot.tga",
        "description": "TGA image",
        "icon": "fileicons/tga",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{linux,darwin}/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CocoaShot"
    },
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{linux,win32}/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "CocoaSuite",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{win32,darwin}/**"
      ]
    },
    "publish": null
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
